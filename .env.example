REDIRECTORY_PROJECT_NAME=redirectory
REDIRECTORY_CONTAINER_NAME=redirectory
REDIRECTORY_CPU_LIMIT=140
REDIRECTORY_MEMORY_LIMIT=256
REDIRECTORY_MIN_SCALE=0
