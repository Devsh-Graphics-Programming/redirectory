REDIRECTORY_GITHUB_REPOSITORY=
REDIRECTORY_PUBLIC_URL=
REDIRECTORY_ENCRYPTION_KEY=
REDIRECTORY_GITHUB_READ_TOKEN=
REDIRECTORY_ANONYMOUS_READ=true
